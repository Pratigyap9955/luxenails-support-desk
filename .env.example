# ──────────────────────────────────────────────────────────────
# LUXENAILS AI Customer Support Desk — environment template
# Copy to backend/.env  (cp .env.example backend/.env)
# Every value below has a working default for Demo Mode.
# ──────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────
# Local docker: `docker compose up -d` then use the URL below as-is.
DATABASE_URL="postgresql://luxenails:luxenails@localhost:5432/luxenails?schema=public"

# ── Authentication ────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION. Any non-empty string works locally.
JWT_SECRET="dev-only-change-me-please-0123456789"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Demo Mode ─────────────────────────────────────────────────
# true  -> no external API calls at all. AI triage, RAG embeddings, reply
#          drafting and Slack alerts run through deterministic local engines.
# false -> uses ANTHROPIC_API_KEY / SLACK_WEBHOOK_URL when present, and
#          transparently falls back to the local engines if a call fails.
# Leaving ANTHROPIC_API_KEY blank forces Demo Mode regardless of this flag.
DEMO_MODE=true

# ── AI (Anthropic Claude) ─────────────────────────────────────
# Optional. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  — controls reasoning depth vs. cost
AI_EFFORT=medium

# ── Slack alerts ──────────────────────────────────────────────
# Optional. https://api.slack.com/messaging/webhooks
# When blank (or in Demo Mode) alerts are captured in the in-app Slack
# outbox on the Escalations page instead of being sent.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL="#luxenails-support"

# ── SLA engine ────────────────────────────────────────────────
# How often the background monitor scans for breaches (seconds)
SLA_SCAN_INTERVAL_SECONDS=60
# Warn when this % of the SLA window has elapsed
SLA_WARNING_THRESHOLD=0.75

# ── RAG ───────────────────────────────────────────────────────
# Characters per knowledge-base chunk, and how many chunks to retrieve
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
# Minimum cosine similarity for a chunk to be considered relevant
RAG_MIN_SCORE=0.12
