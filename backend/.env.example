# See ../.env.example for the fully documented template.
# Quick start: cp ../.env.example .env

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://luxenails:luxenails@localhost:5432/luxenails?schema=public"

JWT_SECRET="dev-only-change-me-please-0123456789"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

DEMO_MODE=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_EFFORT=medium

SLACK_WEBHOOK_URL=
SLACK_CHANNEL="#luxenails-support"

SLA_SCAN_INTERVAL_SECONDS=60
SLA_WARNING_THRESHOLD=0.75

RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
